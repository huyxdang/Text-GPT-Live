# Default surface: V4. V5, V6, and the trained g1 runtime are available explicitly.
TINKER_API_KEY=tml-...
# POLICY_PROMPT=v4     # v4, v5, v6, or g1
# TINKER_MODEL_PATH=   # defaults to <POLICY_PROMPT>:sampler_path in run_state.json
# TINKER_BASE_MODEL=Qwen/Qwen3-8B  # g1 defaults to Qwen/Qwen3.5-4B
# POLICY_MODE=local
# POLICY_PROMPT=g1
# SMOL_LOCAL_MODEL=models/smol-g1-v2-delivery-repair-fixed-mlx-8bit
# SMOL_LOCAL_SESSION_CACHE_LIMIT=8

# Live web search.
SEARCH_MODE=ddgs
# SEARCH_MAX_RESULTS=5
# SEARCH_TIMEOUT_SECONDS=15

# V4-V6 use flat. g1 defaults to its header-free format when POLICY_PROMPT=g1.
# STREAM_FORMAT=flat

# TRACE_PATH=data/sessions.jsonl
