# Released local checkpoint. Download it first; see README.md.
POLICY_MODE=local
POLICY_PROMPT=g1
LOCAL_MODEL_PATH=models/text-gpt-live-mlx-8bit
# LOCAL_ADAPTER_PATH=
# LOCAL_SESSION_CACHE_LIMIT=8
# LOCAL_KV_BITS=
# LOCAL_QUANT_BITS=4

# Tinker serving/training. A key alone does not identify a trained checkpoint.
# TINKER_API_KEY=tml-...
# TINKER_MODEL_PATH=tinker://...
# TINKER_BASE_MODEL=Qwen/Qwen3.5-4B

# Live web search.
SEARCH_MODE=ddgs
# SEARCH_MAX_RESULTS=5
# SEARCH_TIMEOUT_SECONDS=15

# g1 automatically selects the matching stream format.
# STREAM_FORMAT=g1

# TRACE_PATH=data/sessions.jsonl

# Use the operating system TLS trust store on inspected corporate networks.
# SYSTEM_TLS=1
